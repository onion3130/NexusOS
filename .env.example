# Copy this file to .env for local use. Never commit .env.

# Runtime
NEXUS_ENV=development
TZ=UTC

# Persistent runtime data. On the Raspberry Pi, point this to the external SSD mount.
DATA_DIR=./data

# Database mode for the first implementation milestone.
DB_TYPE=sqlite
DATABASE_URL=sqlite:////var/lib/nexus/data/nexus.db

# Authentication bootstrap placeholders.
# Replace locally before the auth milestone; never put real secrets in Git.
JWT_SECRET=replace-with-a-long-random-local-secret
SESSION_COOKIE_SECURE=false

# AI provider selection is intentionally disabled in the scaffold.
AI_PROVIDER=disabled
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
