# NexusOS local environment template
# Copy to .env, replace placeholders locally, and never commit .env.

# Runtime
NEXUS_ENV=development
TZ=UTC
DATA_DIR=./data

# Database
DB_TYPE=sqlite
DATABASE_URL=sqlite:////var/lib/nexus/data/nexus.db

# Authentication — required for the application runtime; never use these placeholders in production.
JWT_SECRET=generate_a_random_secret_here
SESSION_COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Assistant UI is Open WebUI (iframe). Example on a Pi: OPENWEBUI_URL=http://192.168.1.46:8080
# Also settable from Admin → AI. Shared files live under DATA_DIR/shared (linked into Open WebUI as /data/nexus).
OPENWEBUI_URL=
# When a Nexus account is created (or an existing user signs in), Nexus provisions a matching
# Open WebUI user ({username}@nexus.local) with the same password. Prefer an admin API key.
OPENWEBUI_API_KEY=
OPENWEBUI_ADMIN_EMAIL=
OPENWEBUI_ADMIN_PASSWORD=
OPENWEBUI_TIMEOUT_SECONDS=15

# AI provider — disabled is safe by default.
# NVIDIA NIM uses NVIDIA_API_KEY and defaults to the hosted API Catalog endpoints
# when AI_PROVIDER=nvidia_nim. Set AI_BASE_URL explicitly only for a reviewed compatible public endpoint.
AI_PROVIDER=disabled
AI_BASE_URL=
AI_API_KEY=your_api_key_here
AI_MODEL=your_model_name_here
# Hosted NIM (GLM etc.) often needs 60–90s; keep Next proxyTimeout higher than this.
AI_TIMEOUT_SECONDS=90
AI_MAX_CONTEXT_MESSAGES=20
AI_MAX_OUTPUT_TOKENS=1024
AI_MAX_RESPONSE_BYTES=1048576

# Optional semantic retrieval provider. Disabled preserves lexical-only search.
# NVIDIA NIM uses NVIDIA_API_KEY and defaults to the hosted embeddings endpoint
# when EMBEDDING_PROVIDER=nvidia_nim. Set EMBEDDING_BASE_URL only for a reviewed compatible public endpoint.
EMBEDDING_PROVIDER=disabled
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_BATCH_SIZE=8
EMBEDDING_MAX_CHUNK_LENGTH=4000
EMBEDDING_MAX_RESPONSE_BYTES=2097152
EMBEDDING_MAX_DIMENSIONS=2048

# Milestone 10 deployment hardening
TASK_WORKER_INTERVAL_SECONDS=30
TASK_WORKER_BATCH_SIZE=50
# Optional encrypted replication to an operator-mounted off-host destination.
# Both values must be set together. Generate the key with: openssl rand -hex 32
# Hardened Compose maps this host path into /var/lib/nexus/replication.
BACKUP_REPLICATION_HOST_PATH=
BACKUP_REPLICATION_DESTINATION=
BACKUP_ENCRYPTION_KEY=

# Milestone 13 backup retention lifecycle
# Retention cleanup (a confirmed Maintenance action) keeps the newest N verified
# backups and everything younger than D days; the newest backup is always kept.
BACKUP_RETENTION_COUNT=7
BACKUP_RETENTION_DAYS=30
# Key rotation: set this to the OLD BACKUP_ENCRYPTION_KEY value, run the
# "Rotate backup encryption key" action from Maintenance, then remove it.
BACKUP_REPLICATION_KEY_PREVIOUS=

# Milestone 9 read-only workspace views
# Comma-separated absolute roots, or paths relative to DATA_DIR. Keep this empty to scan DATA_DIR only.
WORKSPACE_ROOTS=
# Docker inspection is disabled by default. Set this only with a separately reviewed socket boundary.
DOCKER_SOCKET_PATH=

# Milestone 11 part 2 media library
# Comma-separated absolute media roots the indexer may scan. Empty disables the library.
MEDIA_ROOTS=
# Thumbnail generation bounds (memory-safe for the Raspberry Pi 5).
MEDIA_THUMBNAIL_MAX_DIMENSION=320
MEDIA_INDEX_MAX_SIZE_MB=200

# Milestone 11 part 2 out-of-process plugin boundary
# Empty disables plugin discovery. When configured, this must be an absolute operator-owned directory.
PLUGINS_DIR=
PLUGIN_INVOKE_TIMEOUT_SECONDS=20

# Milestone 11 outbound notification channels (all optional; disabled by default)
# Email channel — set NOTIFICATION_EMAIL_ENABLED=true and complete the SMTP block below.
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_EMAIL_SMTP_HOST=
NOTIFICATION_EMAIL_SMTP_PORT=587
NOTIFICATION_EMAIL_SMTP_USER=
NOTIFICATION_EMAIL_SMTP_PASSWORD=
NOTIFICATION_EMAIL_FROM=
NOTIFICATION_EMAIL_TO=
NOTIFICATION_EMAIL_USE_TLS=true
# Push channel (ntfy-compatible) — set NOTIFICATION_PUSH_ENABLED=true.
NOTIFICATION_PUSH_ENABLED=false
NOTIFICATION_PUSH_URL=
NOTIFICATION_PUSH_TOPIC=
NOTIFICATION_PUSH_TOKEN=
NOTIFICATION_DELIVERY_BATCH_SIZE=20

# Optional provider-specific credentials. Keep placeholder-only in this file.
NVIDIA_API_KEY=your_nvidia_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
