# NexusOS local environment template
# Copy to .env, replace placeholders locally, and never commit .env.

# Runtime
NEXUS_ENV=development
TZ=UTC
DATA_DIR=./data

# Database
DB_TYPE=sqlite
DATABASE_URL=sqlite:////var/lib/nexus/data/nexus.db

# Authentication — required for the application runtime; never use these placeholders in production.
JWT_SECRET=generate_a_random_secret_here
SESSION_COOKIE_SECURE=false

# AI provider — disabled is safe for the current scaffold.
AI_PROVIDER=disabled
AI_BASE_URL=
AI_API_KEY=your_api_key_here
AI_MODEL=your_model_name_here

# Optional provider-specific credentials. Keep placeholder-only in this file.
NVIDIA_API_KEY=your_nvidia_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
