# NexusOS local environment template
# Copy to .env, replace placeholders locally, and never commit .env.

# Runtime
NEXUS_ENV=development
TZ=UTC
DATA_DIR=./data

# Database
DB_TYPE=sqlite
DATABASE_URL=sqlite:////var/lib/nexus/data/nexus.db

# Authentication — required for the application runtime; never use these placeholders in production.
JWT_SECRET=generate_a_random_secret_here
SESSION_COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI provider — disabled is safe for the current scaffold.
AI_PROVIDER=disabled
AI_BASE_URL=
AI_API_KEY=your_api_key_here
AI_MODEL=your_model_name_here
AI_TIMEOUT_SECONDS=20
AI_MAX_CONTEXT_MESSAGES=20
AI_MAX_OUTPUT_TOKENS=512
AI_MAX_RESPONSE_BYTES=1048576

# v1.0 reminder and maintenance worker
TASK_WORKER_INTERVAL_SECONDS=30
TASK_WORKER_BATCH_SIZE=50

# Milestone 9 read-only workspace views
# Comma-separated absolute roots, or paths relative to DATA_DIR. Keep this empty to scan DATA_DIR only.
WORKSPACE_ROOTS=
# Docker inspection is disabled by default. Set this only with a separately reviewed socket boundary.
DOCKER_SOCKET_PATH=

# Optional provider-specific credentials. Keep placeholder-only in this file.
NVIDIA_API_KEY=your_nvidia_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
